# ---- Binance testnet toggle ----
# Set true to use testnet/demo endpoints (price feed + demo-fapi hedge).
BINANCE_USE_TESTNET=true

# ---- Mainnet keys (optional; price feed works without keys) ----
BINANCE_API_KEY=
BINANCE_API_SECRET=

# ---- Binance testnet keys (https://testnet.binance.vision) ----
BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_API_SECRET=

