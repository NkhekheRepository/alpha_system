# Data files (large binary data — commit only metadata, not raw data)
# 5m and 1m candle data are large; include instructions in docs
# Instead, keep reference copies or use Git LFS
user_data/data/binance/*.feather

# Logs (live bot output)
dry_data/dry_output.log
dry_data/bidir_output.log

# Environment (secrets not committed; .env.template IS committed)
.env

# Runtime state (regenerated on each deploy — do NOT commit)
# Live Alpha 3 / Alpha 1 / Alpha 2 state + equity + trade logs:
dry_data/alpha3_state.json
dry_data/alpha3_equity.csv
dry_data/alpha3_trades.csv
dry_data/dry_state.json
dry_data/dry_equity.csv
dry_data/dry_trades.csv
dry_data/bidir_state.json
dry_data/bidir_equity.csv
dry_data/bidir_trades.csv
# Backups, logs, charts, archives:
dry_data/*.bak
dry_data/audit_log.jsonl
dry_data/archive/
dry_data/*.png
# NOTE: dry_data/alpha2_*_prereg.json and *_results.json are kept (governance evidence)

# Charts (regenerated)
dry_data/*.png

# Large result zips
user_data/backtest_results/*.zip

# Deprecated / backup service units
systemd/*.deprecated

