[Unit]
Description=Alpha 3% Runner (TESTNET - no real capital)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/nkhekhe/alpha_system
Environment=PYTHONUNBUFFERED=1
Environment=BINANCE_DEMO_LIVE=true
Environment=TRADING_MODE=testnet
Environment=BINANCE_USE_LIVE=false
Environment=BINANCE_USE_TESTNET=true
ExecStart=/usr/bin/python3 /home/nkhekhe/alpha_system/alpha3_dry_runner.py --stake 0.12 --leverage 20
Restart=always
RestartSec=30

[Install]
WantedBy=default.target