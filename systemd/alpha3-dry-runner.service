[Unit]
Description=Alpha 3% Dry Mode Runner (synthetic resolution, SIM ONLY - no capital)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/nkhekhe/alpha_system
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 /home/nkhekhe/alpha_system/alpha3_dry_runner.py --stake 0.10 --leverage 20
Restart=always
RestartSec=30

[Install]
WantedBy=default.target