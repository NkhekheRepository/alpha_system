[Unit]
Description=Telegram Bot — Alpha 3% Dry Mode command interface (LetapataBot)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/nkhekhe/alpha_system
ExecStart=/bin/bash -c "PYTHONPATH=/home/nkhekhe/alpha_system /usr/bin/python3 /home/nkhekhe/alpha_system/tg_bot_alpha2.py"
Restart=always
RestartSec=30
StartLimitInterval=600
StartLimitBurst=10

[Install]
WantedBy=default.target
